# Variables lues par `docker compose` (copiez ce fichier en .env).

# Obligatoire : jeton exigé pour déposer un rapport (API REST et MCP HTTP).
# Générez-en un : docker run --rm php:8.4-cli php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
API_TOKEN=

# Optionnel : protège la lecture du site (HTTP Basic, nom d'utilisateur libre).
SITE_PASSWORD=

# Base MariaDB (conteneur `db`).
DB_DATABASE=veille
DB_USERNAME=veille
DB_PASSWORD=

# Port exposé sur la machine, et URL publique (utilisée pour les liens générés).
APP_PORT=8080
APP_URL=http://localhost:8080

# Optionnel : clé Laravel. Générée au démarrage si vide (l'app n'utilise ni session ni donnée chiffrée).
APP_KEY=
